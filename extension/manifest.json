{
  "manifest_version": 3,
  "name": "Bookmark Change Tracker",
  "version": "0.1.0",
  "description": "Track changes to bookmarked websites.",
  "permissions": [
    "bookmarks"
  ],
  "host_permissions": [
    "https://ykp7sgqc50.execute-api.us-east-1.amazonaws.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html"
  }
}